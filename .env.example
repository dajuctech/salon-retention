# Copy to .env.local (app) and .env (Prisma CLI). Never commit real values.

# Database (local: docker compose up -d db)
DATABASE_URL="postgresql://salon:salon@localhost:5433/salon"

# App
APP_URL="http://localhost:3000"
# Signs customer manage-booking links (US-11). Generate: openssl rand -base64 32
BOOKING_LINK_SECRET=""
# Protects /api/cron/* (ADR-0004). Vercel Cron sends it as a Bearer token.
CRON_SECRET=""

# Auth (ADR-0003)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Messaging (ADR-0005): console | meta | twilio
MESSAGING_PROVIDER="console"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
MESSAGING_PAUSED="false"

# Payments (ADR-0006): salons connect their own accounts; these are platform keys.
PAYSTACK_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""          # platform webhook endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=""  # Connect endpoint: payments and account.updated from salons' accounts
PLATFORM_FEE_PERCENT="0"          # our fee per online payment, taken by the provider from the salon's payout

# AI (ADR-0007): fake | anthropic | openai — model chosen by evals
AI_PROVIDER="fake"
# Default model when AI_PROVIDER=anthropic: claude-opus-5-5. Choose the cheapest model that passes the evals.
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_PLATFORM_MONTHLY_BUDGET_USD="50"

# Observability (ADR-0009). Leave empty to disable Sentry; logs are JSON lines either way.
SENTRY_DSN=""                  # server errors
SENTRY_ENVIRONMENT=""          # e.g. staging | production
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_DSN=""      # browser errors (loaded only when set)

# Email (staff invitations, sign-in codes): console | resend
EMAIL_TRANSPORT="console"
RESEND_API_KEY=""
EMAIL_FROM="Salon <no-reply@example.com>"
# Extra origins allowed to call the auth API (comma-separated), e.g. a preview URL
BETTER_AUTH_TRUSTED_ORIGINS=""
# Breached-password check on sign-up (production only): on | off
HIBP_CHECK="on"

# Share of new customers held out of win-back messages to measure their real effect (metrics.md)
HOLDOUT_RATE="0.1"
# Show developer tools (run jobs, simulate replies) outside development — never in real production
ALLOW_DEV_TOOLS="false"
# Meta Graph API version for the WhatsApp Cloud API adapter
META_GRAPH_VERSION="v21.0"

# Online bookings allowed per network address per hour (bot/spam protection)
BOOKING_LIMIT_PER_IP="20"

# Online payments: live (default in production) or fake (simulated checkout; default in development)
PAYMENTS_MODE=""
