{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "matchCurrentVersion": "!/^0/", "groupName": "non-major dependencies" },
    { "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg"], "groupName": "prisma" }
  ],
  "vulnerabilityAlerts": { "labels": ["security"] }
}
